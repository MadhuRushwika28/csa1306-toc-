#include <stdio.h>
#include <string.h>

int main() {
    char s[100];
    int i, state = 0;

    printf("Enter string: ");
    scanf("%s", s);

    for (i = 0; s[i] != '\0'; i++) {
        if (s[i] != '0' && s[i] != '1') {
            state = 3;
            break;
        }

        if (state == 0)
            state = (s[i] == '0') ? 1 : 3;
        else if (state == 1)
            state = (s[i] == '0') ? 1 : 2;
        else if (state == 2)
            state = (s[i] == '0') ? 1 : 2;
    }

    if (state == 2)
        printf("String Accepted");
    else
        printf("String Rejected");

    return 0;
}
