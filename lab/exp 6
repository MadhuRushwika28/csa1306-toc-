#include <stdio.h>
#include <string.h>

int main() {
    char s[100];
    int i = 0, j, n, valid = 1;

    printf("Enter string (e for empty): ");
    scanf("%s", s);

    if (strcmp(s, "e") == 0) {
        printf("String Accepted");
        return 0;
    }

    n = strlen(s);

    while (s[i] == '0')
        i++;

    j = i;

    while (s[j] == '1')
        j++;

    if (j != n || i != n - i)
        valid = 0;

    if (valid)
        printf("String Accepted");
    else
        printf("String Rejected");

    return 0;
}
