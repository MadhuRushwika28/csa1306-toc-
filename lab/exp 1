#include <stdio.h>
#include <string.h>

int main() {
    char str[100];
    int i, state = 0;
    printf("Enter a string: ");
    scanf("%s", str);
    for (i = 0; i < strlen(str); i++) {
        if (state == 0 && str[i] == 'a')
            state = 1;
        else if (state == 1 && str[i] == 'a')
            state = 1;
        else if (state == 1 && str[i] == 'b')
            state = 2;
        else if (state == 2 && str[i] == 'a')
            state = 1;
        else if (state == 2 && str[i] == 'b')
            state = 2;
        else {
            state = 3;
            break;
        }
    }
    if (state == 1)
        printf("String Accepted");
    else
        printf("String Rejected");
    return 0;
}
