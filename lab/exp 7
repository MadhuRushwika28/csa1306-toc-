#include <stdio.h>
#include <string.h>

int main() {
    char s[100];
    int i, valid = 0, binary = 1;

    printf("Enter binary string: ");
    scanf("%s", s);

    for (i = 0; s[i] != '\0'; i++) {
        if (s[i] != '0' && s[i] != '1')
            binary = 0;
    }

    if (strstr(s, "101") != NULL)
        valid = 1;

    if (binary && valid)
        printf("String Accepted");
    else
        printf("String Rejected");

    return 0;
}
